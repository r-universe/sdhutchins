[submodule ".registry"]
	path = .registry
	url = https://github.com/sdhutchins/sdhutchins.r-universe.dev
	branch = HEAD
[submodule "JournalAnalysis"]
	path = JournalAnalysis
	url = https://github.com/vallenderlab/JournalAnalysis
[submodule "MicrobiomeR"]
	path = MicrobiomeR
	url = https://github.com/vallenderlab/MicrobiomeR
[submodule "documenteR"]
	path = documenteR
	url = https://github.com/sdhutchins/documenteR
[submodule "harlem"]
	path = harlem
	url = https://github.com/sdhutchins/harlem
[submodule "pkgmkr"]
	path = pkgmkr
	url = https://github.com/sdhutchins/pkgmkr
[submodule "victortools"]
	path = victortools
	url = https://github.com/sdhutchins/victortools
